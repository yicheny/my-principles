---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getExcerpt } from '../utils/excerpt';

const base = import.meta.env.BASE_URL;
const principles = (await getCollection('principles')).sort((a, b) => a.data.order - b.data.order);
const keyPoints = (await getCollection('keyPoints')).sort((a, b) => a.data.order - b.data.order);
const dailyEntries = (await getCollection('daily')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 5);
const notesEntries = (await getCollection('notes')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 5);
---

<Base title="我的原则">
  <div class="hero">
    <h1>我的原则</h1>
    <p>记录学习与生活中的核心准则，用来指导决策和行动。</p>
  </div>

  <h2 class="section-title">⚡ 原则</h2>
  <div class="card-list">
    {principles.length === 0 && <p style="color: var(--color-text-secondary)">暂无内容</p>}
    {principles.map((entry) => (
      <a href={`${base}/principles/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p class="excerpt">{getExcerpt(entry.body)}</p>
      </a>
    ))}
  </div>

  <h2 class="section-title">🔑 专题知识点</h2>
  <div class="card-list">
    {keyPoints.length === 0 && <p style="color: var(--color-text-secondary)">暂无内容</p>}
    {keyPoints.map((entry) => (
      <a href={`${base}/keyPoints/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p class="excerpt">{getExcerpt(entry.body)}</p>
      </a>
    ))}
  </div>

  <h2 class="section-title">📝 每日学习</h2>
  <div class="card-list">
    {dailyEntries.length === 0 && <p style="color: var(--color-text-secondary)">暂无内容</p>}
    {dailyEntries.map((entry) => (
      <a href={`${base}/daily/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.25rem;">{entry.data.date}</p>
        <p class="excerpt">{getExcerpt(entry.body)}</p>
      </a>
    ))}
  </div>

  <h2 class="section-title">📒 学习笔记</h2>
  <div class="card-list">
    {notesEntries.length === 0 && <p style="color: var(--color-text-secondary)">暂无内容</p>}
    {notesEntries.map((entry) => (
      <a href={`${base}/notes/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.85rem; margin-top: 0.25rem;">{entry.data.date}</p>
        <p class="excerpt">{getExcerpt(entry.body)}</p>
      </a>
    ))}
  </div>
</Base>

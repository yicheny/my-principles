---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getExcerpt } from '../../utils/excerpt';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('daily')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Base title="每日学习">
  <a href={base} class="back-link">&larr; 返回首页</a>
  <h2 class="section-title">📝 每日学习</h2>
  <div class="card-list">
    {entries.length === 0 && <p style="color: var(--color-text-secondary)">暂无内容</p>}
    {entries.map((entry) => (
      <a href={`${base}/daily/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p class="meta">{entry.data.date}</p>
        <p class="excerpt">{getExcerpt(entry.body)}</p>
      </a>
    ))}
  </div>
</Base>

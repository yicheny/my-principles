---
---
<span class="tip-wrapper">
  <span class="tip-trigger">
    <slot />
    <span class="tip-icon">?</span>
  </span>
  <span class="tip-tooltip">
    <slot name="answer" />
  </span>
</span>

<style>
  .tip-wrapper {
    position: relative;
    display: inline;
  }

  .tip-trigger {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-text-secondary);
    cursor: help;
  }

  .tip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    margin-left: 2px;
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    background: var(--color-accent);
    border-radius: 50%;
    vertical-align: super;
    line-height: 1;
  }

  .tip-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: #1e1e1e;
    color: #e4e4e4;
    font-size: 0.82rem;
    line-height: 1.5;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    max-width: 720px;
    width: max-content;
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    z-index: 100;
  }

  .tip-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #1e1e1e;
  }

  .tip-wrapper:hover .tip-tooltip {
    opacity: 1;
    pointer-events: auto;
  }
</style>

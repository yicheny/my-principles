---
interface Props {
  tabs?: string[];
}

const { tabs = ['问题', '答案'] } = Astro.props;
const count = tabs.length;
---

<div class="tabs">
  <div class="tab-bar">
    {tabs.map((tab, i) => (
      <button class:list={['tab-btn', { active: i === 0 }]} data-index={i}>
        {tab}
      </button>
    ))}
  </div>
  <div class="tab-panels">
    <div class:list={['tab-panel', 'active']} data-index="0">
      <slot name="tab0" />
    </div>
    <div class:list={['tab-panel']} data-index="1">
      <slot name="tab1" />
    </div>
    {count >= 3 && (
      <div class:list={['tab-panel']} data-index="2">
        <slot name="tab2" />
      </div>
    )}
  </div>
</div>

<script>
  document.querySelectorAll('.tabs').forEach((container) => {
    const buttons = container.querySelectorAll('.tab-btn');
    const panels = container.querySelectorAll('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = btn.getAttribute('data-index');
        buttons.forEach((b) => b.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        container.querySelector(`.tab-panel[data-index="${index}"]`)?.classList.add('active');
      });
    });
  });
</script>

<style>
  .tabs {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin: 1rem 0;
  }

  /* slot 内容来自 MDX，无 data-astro 作用域，需 :global 才能选中内部 p */
  .tab-panel :global(p) {
    margin-bottom: 0;
  }

  .tab-bar {
    display: flex;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    border-radius: 8px 8px 0 0;
  }

  .tab-btn {
    padding: 0.6rem 1.2rem;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: #64748b;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }

  .tab-btn:hover {
    color: #334155;
  }

  .tab-btn.active {
    color: #1e293b;
    border-bottom-color: #3b82f6;
    background: #fff;
  }

  .tab-panel {
    display: none;
    padding: 0.75rem 1rem;
  }

  .tab-panel.active {
    display: block;
  }
</style>
